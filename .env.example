# RideRite backend this admin panel talks to (required — there is no default)
VITE_API_URL=https://riderite-backend.deployment-uat.com
# Sign admins out after this many minutes without activity (default 15)
VITE_ADMIN_IDLE_MINUTES=15
# Public website (rider/driver web app) — the admin login footer and Legal pages editor link to
# its /terms, /privacy and /eula. Default https://getriderite.com
VITE_WEB_APP_URL=
